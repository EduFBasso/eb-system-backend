{
  "folders": [
    {
      "name": "⚙️ ENGINE - Backend (Django)",
      "path": "backend",
    },
  ],

  "settings": {
    // Git: detectar o repositório real na pasta pai do workspace multi-root
    "git.openRepositoryInParentFolders": "always",

    // Python: sempre usar o .venv do backend
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
    "python.terminal.activateEnvironment": true,

    // Terminal sempre abre no backend
    "terminal.integrated.cwd": "${workspaceFolder}",

    // Ocultar arquivos que só poluem
    "files.exclude": {
      "**/__pycache__": true,
      "**/.pytest_cache": true,
      "**/.venv": false,
    },

    // Formatação
    "editor.formatOnSave": true,
  },
}
